# Groq (plano gratuito): cria uma chave em https://console.groq.com
GROQ_API_KEY=gsk_...
# Opcional: modelo Groq (por omissão: openai/gpt-oss-120b; recurso: openai/gpt-oss-20b)
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# GROQ_REASONING=low

# Ou xAI Grok, usado quando GROQ_API_KEY não está definida
# XAI_API_KEY=xai-...
# XAI_MODEL=grok-4
